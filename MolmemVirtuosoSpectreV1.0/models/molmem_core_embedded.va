// ============================================================================
// Molecular Memristor Compact Physics Core (Verilog-A)
// Module: molmem_core
//
// Complete implementation of continuous kinetic ODE and transport physics
// from Python `molmem_lib` (device_jit.py) with exact CPU-style fastpaths.
//
// Fastpaths included:
//   1. Zero/Micro-Volt Fastpath (|V| < 1e-6 V): Bypasses all transcendental math
//   2. Sub-threshold Fastpath (|V| < vBypass): Bypasses power-law ODE for read/idle
//   3. Saturated Boundary Fastpath (n >= n_max with V > Vth, or n <= 0 with V < -Vth)
//   4. Zero Conductance Fastpath (f22 <= 0.0): Bypasses sinh() current transport
//   5. Asymptotically Bounded Softplus & Tanh: Prevents floating point overflow
// ============================================================================

`include "disciplines.vams"
`include "constants.vams"

// ============================================================================
// High-Speed Direct O(1) Linear Interpolation Macro for Uniform PWL Arrays
// Matches Python jit_interp_O1: O(1) direct array indexing, zero while loops
// ============================================================================
`define PWL_O1_LOOKUP(res, x_in, y_arr, X_MAX, INV_DX, N_PTS) \
    begin \
        interp_x = x_in; \
        if (interp_x <= 0.0) begin \
            res = y_arr[0]; \
        end else if (interp_x >= X_MAX) begin \
            res = y_arr[N_PTS - 1]; \
        end else begin \
            interp_u = interp_x * INV_DX; \
            interp_idx = interp_u; \
            if (interp_idx < 0) interp_idx = 0; \
            else if (interp_idx >= N_PTS - 1) interp_idx = N_PTS - 2; \
            interp_frac = interp_u - interp_idx; \
            res = y_arr[interp_idx] + interp_frac * (y_arr[interp_idx + 1] - y_arr[interp_idx]); \
        end \
    end

// ============================================================================
// High-Speed Binary-Search Piecewise-Linear Interpolation Macro
// Bounds to [y[0], y[N-1]] outside [x[0], x[N-1]]; performs bisection search
// ============================================================================
`define PWL_LOOKUP(res, x_in, x_arr, y_arr, N_PTS) \
    begin \
        interp_x = x_in; \
        if (interp_x <= x_arr[0]) begin \
            res = y_arr[0]; \
        end else if (interp_x >= x_arr[N_PTS - 1]) begin \
            res = y_arr[N_PTS - 1]; \
        end else begin \
            interp_lo = 0; \
            interp_hi = N_PTS - 1; \
            while (interp_hi - interp_lo > 1) begin \
                interp_mid = (interp_lo + interp_hi) / 2; \
                if (interp_x >= x_arr[interp_mid]) begin \
                    interp_lo = interp_mid; \
                end else begin \
                    interp_hi = interp_mid; \
                end \
            end \
            interp_frac = (interp_x - x_arr[interp_lo]) / (x_arr[interp_hi] - x_arr[interp_lo]); \
            res = y_arr[interp_lo] + interp_frac * (y_arr[interp_hi] - y_arr[interp_lo]); \
        end \
    end

// ============================================================================
// Constant Value Direct Assignment Macro for Flat PWL Tables
// Completely avoids array search and interpolation when values are uniform
// ============================================================================
`define PWL_CONST_LOOKUP(res, y_arr) \
    begin \
        res = y_arr[0]; \
    end

module molmem_core(TE, BE, f22, pulseState, conductance, junctionTemp);

    // --- External Terminals ---
    inout TE, BE;
    output f22, pulseState, conductance, junctionTemp;

    electrical TE, BE;
    electrical f22, pulseState, conductance, junctionTemp;

    // --- Physics Parameters (Default Alignment to devices.py) ---
    parameter real V_smooth        = 0.103776   from (0:inf);    // Voltage smoothing parameter (V)
    parameter real n_smooth        = 17.06      from (0:inf);    // Boundary clamping smoothness
    parameter real kappa           = 1.172865e7 from (0:inf);    // Base transition rate (states/sec)
    parameter real alpha           = 0.931756   from (0:inf);    // Non-linear acceleration exponent
    parameter real gScale          = 6.227303   from (0:inf);    // Conductance multiplier
    parameter real Vth             = 0.466409   from (0:inf);    // Threshold switching voltage (V)
    parameter real Vref_pos        = 0.900000   from (0:inf);    // Positive reference voltage (V)
    parameter real Vref_neg        = 0.750000   from (0:inf);    // Negative reference voltage (V)
    parameter real rate_asymmetry  = 0.985694   from (0:inf);    // Rate asymmetry ratio (RESET / SET)
    parameter real n_max           = 33040.0    from (0:inf);    // Maximum state bound
    parameter real n_init          = 0.0        from [0:n_max];  // Initial state condition
    parameter real K_discharge     = 362.88     from [0:inf);    // Dynamic reset discharge speed
    parameter real f22_start_val   = 0.12037256 from (0:1);      // f22 potentiation baseline
    parameter real f22_peak_val    = 0.87791974 from (0:1);      // f22 peak value
    parameter real f22_end_val     = 0.13955489 from (0:1);      // f22 depression baseline

    // Stark & Thermal Parameters (from devices.py)
    parameter real gamma           = -0.012230;                  // State-to-barrier coupling
    parameter real beta_alpha      = 0.125186;                   // High-field alpha coefficient
    parameter real beta_s          = -4.382853;                  // High-field n_smooth coefficient
    parameter real E_a             = 0.155923   from [0:inf);    // Activation energy (eV)
    parameter real R_th            = 52.14      from [0:inf);    // Thermal resistance (K/W)
    parameter real tau_th          = 1.278e-7   from (0:inf);    // Thermal relaxation time constant (s)

    // Unified Saturation & Recovery Parameters (from devices.py)
    parameter real rTopBlend       = 0.050000;                   // Top blend ratio
    parameter real fDischarge      = 0.374848;                   // Discharge decay power index
    parameter real cDischarge      = 0.0;                        // Initial / override write overdrive
    parameter real rBottomBlend    = 0.714488;                   // Bottom blend scale factor
    parameter real rLatency        = 0.878506;                   // Latency shelf ratio
    parameter real k_overdrive     = 7.296635;                   // Overdrive turnaround sensitivity

    // Empirical Multi-Channel Noise Parameters (from PWL models)
    parameter real noise_en                = 0.0        from [0:1];      // Master noise switch (0=Off, 1=On)
    parameter real d2d_variation_intensity = 0.0        from [0:inf);    // D2D Mismatch intensity
    parameter real d2d_u                   = 0.5        from [0:1];      // Uniform quantile u in [0, 1] for D2D inverse-CDF
    parameter real read_noise_intensity    = 0.0        from [0:inf);    // Temporal read noise intensity
    parameter real write_noise_intensity   = 0.0        from [0:inf);    // Cycle-to-cycle write noise intensity
    parameter real write_noise_seed        = 0.0;                        // Normal(0, 1) stochastic seed for write noise
    parameter integer mon_en               = 0          from [0:1];      // Diagnostic pin export switch (0=Off, 1=On)

    // Precomputed Constants & Inverses
    localparam real f22_pot_scale_inv     = 1.0 / (f22_peak_val - f22_start_val);
    localparam real f22_dep_scale_inv     = 1.0 / (f22_peak_val - f22_end_val);
    localparam real one_minus_f22_end_val = 1.0 - f22_end_val;
    localparam real vBypass               = Vth - 3.0 * V_smooth;    // Safe sub-threshold early exit (0.155V)
    localparam real inv_V_smooth          = 1.0 / V_smooth;
    localparam real inv_300               = 1.0 / 300.0;
    localparam real inv_30                = 1.0 / 30.0;
    localparam real inv_16520             = 1.0 / 16520.0;
    localparam real n_base_nominal        = 0.5 * n_max;
    localparam real scale_base            = (rBottomBlend >= 0.05 && rBottomBlend <= 2.5) ? rBottomBlend : 1.0;
    localparam real one_minus_scale_base  = 1.0 - scale_base;
    localparam real gamma_eff             = gamma;
    localparam real scale_top             = (rTopBlend >= 0.001 && rTopBlend <= 0.5) ? rTopBlend : 0.05;
    localparam real r_lat                 = (rLatency >= 0.0 && rLatency < 0.999) ? rLatency : 0.5;
    localparam real k_amp                 = (K_discharge > 0.0) ? K_discharge : 0.0;
    localparam real p_decay               = (fDischarge >= 0.05 && fDischarge <= 0.95) ? (1.0 / fDischarge) : 2.5;
    localparam real d_val_pos             = Vref_pos - Vth + 1e-6;
    localparam real d_val_neg             = Vref_neg - Vth + 1e-6;
    localparam real inv_d_val_pos         = 1.0 / ((d_val_pos > 1e-15) ? d_val_pos : 1e-15);
    localparam real inv_d_val_neg         = 1.0 / ((d_val_neg > 1e-15) ? d_val_neg : 1e-15);
    localparam real vs_inv_d_val_pos      = V_smooth * inv_d_val_pos;
    localparam real vs_inv_d_val_neg      = V_smooth * inv_d_val_neg;
    localparam real ea_arrhenius          = (E_a > 0.0) ? (E_a * 11604.51812063) : 0.0;
    localparam real inv_tau_th            = (tau_th > 0.0) ? (1.0 / tau_th) : 0.0;

    // --- Internal Real Variables ---
    real v_int, abs_v;
    real n_raw, mode_raw, temp_raw;
    real n_curr, mode_curr, scale_curr, scale_latch, temp_curr, c_od_curr, c_od_latch;
    real tanh_arg, v_tanh;
    real softplus_arg, softplus;
    real clamp_factor, w_bound, dist_bound, z_bound;
    real kappa_clamp, d_val, base_rate, rate_mag, s_pol, vref_eff;
    real dn_dt;
    real n_base, od_ratio, overdrive, od_clamp, w_trans, u_base, s_base;
    real n_turnaround, excursion, u_sat, u_rec, w_top, dist_from_peak, z_top, s_top;
    real r_lat_eff, u_decay, eff_rate_factor, eff_mult;
    real target_mode, d_mode_dt;
    real f22_pot_raw, f22_dep_raw;
    real f22_pot_scaled, f22_dep_scaled;
    real denom_scale, target_scale;
    real f22_active, i_mem, v_clip;
    real alpha_eff, n_smooth_eff;
    real delta_v, tanh_delta_v, p_diss, t_steady, d_temp_dt, thermal_factor, t_amb;
    real od_inst;
    real gScale_eff, d2d_delta;
    real rel_sigma_read, i_floor_noise, i_scale_noise, pwr_read_noise;
    real rel_sigma_write;
    real g_i_scale, inv_v_scale_val;

    // ========================================================================
    // Embedded Empirical PWL Characterization Arrays (Protected IP Data)
    // Generated automatically by SpectreModelDataEncryption/build_encryption_package.py
    // ========================================================================
    real y_pot[0:3400];
    real y_dep[0:3400];
    real x_d2d[0:102], y_d2d[0:102];
    real x_rnoise[0:24], y_rnoise[0:24];
    real x_wnoise[0:51], y_wnoise[0:51];
    real y_vscale[0:0];
    real y_iscale[0:0];

    // Fast Interpolation Registers
    integer interp_lo, interp_hi, interp_mid, interp_idx;
    real interp_x, interp_u, interp_frac;

    analog begin

        // --- One-Time Simulation & Invariant Initialization ---
        @(initial_step or initial_step("tran")) begin
            scale_latch    = 1.0;
            scale_curr     = 1.0;
            c_od_latch     = cDischarge;
        // --- Populating Embedded Empirical PWL Data Tables at t=0 ---
        // Table: f22_pot_map.pwl (3401 points)
        y_pot[0]=0.120662;y_pot[1]=0.121086;y_pot[2]=0.12151;y_pot[3]=0.121934;y_pot[4]=0.122358;
        y_pot[5]=0.122783;y_pot[6]=0.123208;y_pot[7]=0.123633;y_pot[8]=0.124058;y_pot[9]=0.124483;
        y_pot[10]=0.124909;y_pot[11]=0.125335;y_pot[12]=0.125761;y_pot[13]=0.126188;y_pot[14]=0.126615;
        y_pot[15]=0.127042;y_pot[16]=0.127469;y_pot[17]=0.127896;y_pot[18]=0.128324;y_pot[19]=0.128752;
        y_pot[20]=0.12918;y_pot[21]=0.129609;y_pot[22]=0.130038;y_pot[23]=0.130467;y_pot[24]=0.130896;
        y_pot[25]=0.131326;y_pot[26]=0.131756;y_pot[27]=0.132186;y_pot[28]=0.132616;y_pot[29]=0.133047;
        y_pot[30]=0.133478;y_pot[31]=0.13391;y_pot[32]=0.134341;y_pot[33]=0.134773;y_pot[34]=0.135205;
        y_pot[35]=0.135638;y_pot[36]=0.13607;y_pot[37]=0.136503;y_pot[38]=0.136936;y_pot[39]=0.13737;
        y_pot[40]=0.137804;y_pot[41]=0.138238;y_pot[42]=0.138672;y_pot[43]=0.139106;y_pot[44]=0.139541;
        y_pot[45]=0.139976;y_pot[46]=0.140411;y_pot[47]=0.140847;y_pot[48]=0.141282;y_pot[49]=0.141718;
        y_pot[50]=0.142154;y_pot[51]=0.14259;y_pot[52]=0.143026;y_pot[53]=0.143463;y_pot[54]=0.1439;
        y_pot[55]=0.144336;y_pot[56]=0.144773;y_pot[57]=0.145211;y_pot[58]=0.145648;y_pot[59]=0.146085;
        y_pot[60]=0.146523;y_pot[61]=0.146961;y_pot[62]=0.147399;y_pot[63]=0.147837;y_pot[64]=0.148275;
        y_pot[65]=0.148713;y_pot[66]=0.149151;y_pot[67]=0.14959;y_pot[68]=0.150028;y_pot[69]=0.150467;
