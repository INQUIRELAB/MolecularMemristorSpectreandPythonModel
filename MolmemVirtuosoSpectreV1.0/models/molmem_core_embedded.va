        x_wnoise[51]=1;y_wnoise[51]=0.12582598;

        // Table: V_scale.pwl (2 points)
        y_vscale[0]=0.343826;

        // Table: I_scale.pwl (2 points)
        y_iscale[0]=0.00025;

            inv_v_scale_val = 1.0 / y_vscale[0];
            // One-Time Device-to-Device (D2D) Quantile Evaluation
            if (d2d_variation_intensity > 0.0) begin
                `PWL_LOOKUP(d2d_delta, d2d_u, x_d2d, y_d2d, 103)
                gScale_eff = gScale * (1.0 + d2d_variation_intensity * d2d_delta);
                if (gScale_eff < 1e-6) gScale_eff = 1e-6;
            end else begin
                gScale_eff = gScale;
            end
            g_i_scale      = gScale_eff * y_iscale[0];
        end


        // 1. Read Terminal Voltage & Ambient Environment Temperature
        t_amb = $temperature;
        v_int = V(TE, BE);
        abs_v = abs(v_int);

        // 2. Continuous State Integrations via Native idt Operator
        n_raw     = idt(dn_dt, n_init);
        mode_raw  = idt(d_mode_dt, 1.0);
        temp_raw  = idt(d_temp_dt, t_amb);

        // State Clamping for Robust Numerical Evaluation
        if (n_raw < 0.0)             n_curr = 0.0;
        else if (n_raw > n_max)      n_curr = n_max;
        else                         n_curr = n_raw;

        if (mode_raw < 0.0)          mode_curr = 0.0;
        else if (mode_raw > 1.0)     mode_curr = 1.0;
        else                         mode_curr = mode_raw;

        if (temp_raw < t_amb)        temp_curr = t_amb;
        else if (temp_raw > 1500.0)  temp_curr = 1500.0;
        else                         temp_curr = temp_raw;

        // Dynamic Overdrive State Latch (matches Python device_jit.py lines 489-496)
        if (mode_curr > 0.5 && n_curr > n_base_nominal) begin
            if (v_int > Vref_pos && (d_val_pos > 1e-6)) begin
                od_inst = (v_int - Vref_pos) * inv_d_val_pos;
                if (od_inst > c_od_latch) c_od_latch = od_inst;
            end
        end else if (n_curr <= n_base) begin
            c_od_latch = 0.0;
        end
        c_od_curr = (c_od_latch > 10.0) ? 10.0 : ((c_od_latch < 0.0) ? 0.0 : c_od_latch);

        // Dynamic Landing Baseline Floor & Overdrive Memory Clamp
        if (c_od_curr <= 0.0) begin
            od_clamp = 0.0;
            n_base = n_base_nominal;
        end else begin
            overdrive = (k_overdrive > 0.0) ? (c_od_curr * k_overdrive) : 0.0;
            od_clamp = (overdrive > 1.0) ? 1.0 : overdrive;
            n_base = n_base_nominal * (1.0 - od_clamp * one_minus_scale_base);
        end

        // High-Field Stark Dynamic Barrier Scaling (matches device_jit.py)
        if (v_int > Vref_pos && (beta_alpha != 0.0 || beta_s != 0.0)) begin
            delta_v = (v_int - Vref_pos) * inv_d_val_pos;
            tanh_delta_v = tanh(delta_v);
            alpha_eff = alpha + beta_alpha * tanh_delta_v;
            if (alpha_eff < 0.1) alpha_eff = 0.1;
            else if (alpha_eff > 1000.0) alpha_eff = 1000.0;
            n_smooth_eff = n_smooth * (1.0 + beta_s * tanh_delta_v);
            if (n_smooth_eff < 1.0) n_smooth_eff = 1.0;
            else if (n_smooth_eff > 1000.0) n_smooth_eff = 1000.0;
        end else begin
            alpha_eff = alpha;
            n_smooth_eff = n_smooth;
        end

        // --------------------------------------------------------------------
        // KINETIC RATES DETERMINATION (dn_dt, d_mode_dt)
        // --------------------------------------------------------------------
        if (abs_v < 1e-6) begin
            // FASTPATH 1: Near-Zero Applied Voltage (|V| < 1e-6 V)
            dn_dt     = 0.0;
            d_mode_dt = -1000.0 * mode_curr;
            v_tanh    = 0.0;
        end
        else if ((n_curr >= n_max && v_int >= Vth) || (n_curr <= 0.0 && v_int <= -Vth)) begin
            // FASTPATH 2: Boundary Saturation under Drive Voltages
            dn_dt       = 0.0;
            target_mode = (v_int > 0.0) ? 1.0 : 0.0;
            d_mode_dt   = (target_mode - mode_curr) * 1.0e9;
            v_tanh      = (v_int > 0.0) ? 1.0 : -1.0;
        end
        else begin
            // FULL PATH: General Active Kinetic Dynamics
            tanh_arg = v_int * inv_V_smooth;
            if (tanh_arg > 20.0)       v_tanh = 1.0;
            else if (tanh_arg < -20.0) v_tanh = -1.0;
            else                       v_tanh = tanh(tanh_arg);

            if (abs_v < vBypass && (n_curr <= n_base || K_discharge == 0.0)) begin
                dn_dt = 0.0;
            end else begin
                softplus_arg = (abs_v - Vth) * inv_V_smooth;
                if (softplus_arg > 20.0)       softplus = softplus_arg;
                else if (softplus_arg < -20.0) softplus = 0.0;
                else                           softplus = ln(1.0 + exp(softplus_arg));

                if (softplus <= 0.0) begin
                    dn_dt = 0.0;
                end else begin
                    if (v_tanh > 0.0) begin
                        w_bound = (1.5 * n_smooth_eff > 50.0) ? (1.5 * n_smooth_eff) : 50.0;
                        dist_bound = n_max - n_curr;
                        if (dist_bound >= w_bound) clamp_factor = 1.0;
                        else if (dist_bound <= 0.0) clamp_factor = 0.0;
                        else begin
                            z_bound = dist_bound / w_bound;
                            clamp_factor = z_bound * z_bound * (3.0 - 2.0 * z_bound);
                        end
                    end else if (v_tanh < 0.0) begin
                        w_bound = 30.0;
                        if (n_curr >= w_bound) clamp_factor = 1.0;
                        else if (n_curr <= 0.0) clamp_factor = 0.0;
                        else begin
                            z_bound = n_curr * inv_30;
                            clamp_factor = z_bound * z_bound * (3.0 - 2.0 * z_bound);
                        end
                    end else begin
                        clamp_factor = 1.0;
                    end

                    kappa_clamp = kappa * clamp_factor;

                    if (v_tanh == 1.0) begin
                        base_rate = softplus * vs_inv_d_val_pos;
                        dn_dt = pow(base_rate, alpha_eff) * kappa_clamp;
                    end else if (v_tanh == -1.0) begin
                        base_rate = softplus * vs_inv_d_val_neg;
                        dn_dt = -pow(base_rate, alpha_eff) * (kappa_clamp * rate_asymmetry);
                    end else begin
                        s_pol = 0.5 * (1.0 + v_tanh);
                        vref_eff = s_pol * Vref_pos + (1.0 - s_pol) * Vref_neg;
                        d_val = vref_eff - Vth + 1e-6;
                        base_rate = (V_smooth * softplus * abs(v_tanh)) / ((d_val > 1e-15) ? d_val : 1e-15);
                        rate_mag = pow(base_rate, alpha_eff);
                        if (v_tanh > 0.0) begin
                            dn_dt = rate_mag * v_tanh * kappa_clamp;
                        end else begin
                            dn_dt = rate_mag * v_tanh * (kappa_clamp * rate_asymmetry);
                        end
                    end
                end
            end

            // Unified Saturation Recovery (matches device_jit.py lines 231-285)
            if ((mode_curr < 0.45 || v_tanh < 0.0) && n_curr > 500.0) begin
                u_base = (n_curr - (n_base - 150.0)) * inv_300;
                if (u_base >= 1.0)      s_base = 1.0;
                else if (u_base <= 0.0) s_base = 0.0;
                else                    s_base = u_base * u_base * (3.0 - 2.0 * u_base);

                if (s_base > 0.0) begin
                    n_turnaround = n_max;
                    excursion = n_turnaround - n_base;
                    if (excursion < 100.0) excursion = 100.0;

                    u_rec = (n_curr - n_base) / excursion;
                    if (u_rec < 0.0) u_rec = 0.0;
                    else if (u_rec > 1.0) u_rec = 1.0;

                    w_top = scale_top * excursion;
                    if (w_top < 30.0) w_top = 30.0;
                    dist_from_peak = n_turnaround - n_curr;
                    if (dist_from_peak >= w_top) s_top = 1.0;
                    else if (dist_from_peak <= 0.0) s_top = 0.0;
                    else begin
                        z_top = dist_from_peak / w_top;
                        s_top = z_top * z_top * (3.0 - 2.0 * z_top);
                    end

                    r_lat_eff = (od_clamp > 0.0) ? (((1.0 - od_clamp) > 0.0) ? (r_lat * (1.0 - od_clamp)) : 0.0) : r_lat;
                    u_decay = (u_rec > 0.0) ? pow(u_rec, p_decay) : 0.0;
                    eff_rate_factor = (1.0 - r_lat_eff) + (r_lat_eff + k_amp * s_top) * u_decay;
                    eff_mult = 1.0 - s_base * (1.0 - eff_rate_factor);
                    dn_dt = dn_dt * eff_mult;
                end
            end

            // Thermal Arrhenius Acceleration Scaling
            if (E_a > 0.0 && R_th > 0.0) begin
                if (abs(temp_curr - 298.15) < 1e-4) begin
                    thermal_factor = 1.0;
                end else begin
                    thermal_factor = exp(ea_arrhenius * (0.00335401643468 - 1.0 / temp_curr));
                end
                dn_dt = dn_dt * thermal_factor;
            end

            // Cycle-to-Cycle Langevin Write Noise
            if (noise_en > 0.5 && write_noise_intensity > 0.0 && abs_v > Vth) begin
                `PWL_LOOKUP(rel_sigma_write, f22_active, x_wnoise, y_wnoise, 52)
                if (rel_sigma_write < 0.0) rel_sigma_write = 0.0;
                dn_dt = dn_dt * (1.0 + write_noise_intensity * rel_sigma_write * write_noise_seed);
            end

            // Prevent boundary blowup outside [0, n_max]
            if (n_curr <= 0.0 && dn_dt < 0.0) dn_dt = 0.0;
            if (n_curr >= n_max && dn_dt > 0.0) dn_dt = 0.0;

            // Direction Latch Hysteresis Dynamics (d_mode/dt)
            if (abs_v <= Vth) begin
                d_mode_dt = -1000.0 * mode_curr;
            end else begin
                target_mode = (v_int > Vth) ? 1.0 : 0.0;
                d_mode_dt   = (target_mode - mode_curr) * 1.0e9;
            end
        end

        // --------------------------------------------------------------------
        // UNIFIED CONDUCTION, TABLES & STATE OUTPUTS
        // --------------------------------------------------------------------
        `PWL_O1_LOOKUP(f22_pot_raw, n_curr, y_pot, 33040.0, 0.102905569007, 3401)
        `PWL_O1_LOOKUP(f22_dep_raw, n_max - n_curr, y_dep, 33040.0, 0.102905569007, 3401)

        f22_pot_scaled = (f22_pot_raw - f22_start_val) * f22_pot_scale_inv;
        if (f22_pot_scaled > 0.0 && n_curr > 16520.0) begin
            u_sat = (n_curr - 16520.0) * inv_16520;
            if (u_sat > 1.0) u_sat = 1.0;
            f22_pot_scaled = f22_pot_scaled + 0.001 * n_smooth_eff * u_sat * u_sat * (3.0 - 2.0 * u_sat);
        end
        f22_dep_scaled = (one_minus_f22_end_val - f22_dep_raw) * f22_dep_scale_inv;

        // Continuity Scale Factor (Algebraic Tracking with Memory Latch)
        if (mode_curr > 0.6 && v_tanh > 0.0) begin
            denom_scale = (f22_dep_scaled > 1e-6) ? f22_dep_scaled : 1e-6;
            target_scale = f22_pot_scaled / denom_scale;
            if (target_scale < 0.0) target_scale = 0.0;
            else if (target_scale > 100.0) target_scale = 100.0;
            scale_latch = target_scale;
            scale_curr  = target_scale;
        end else begin
            scale_curr  = scale_latch;
        end

        // Active State Selection
        if (mode_curr > 0.5) begin
            f22_active = f22_pot_scaled;
        end else begin
            f22_active = f22_dep_scaled * scale_curr;
        end
        if (f22_active < 0.0) f22_active = 0.0;

        // Output Conduction Current (Analytical zero-volt fastpath matching jit_getIGeq)
        if (abs_v < 1e-12 || f22_active <= 0.0) begin
            i_mem = 0.0;
        end else begin
            v_clip = (gamma_eff != 0.0) ? (v_int * (1.0 + gamma_eff * f22_active) * inv_v_scale_val) : (v_int * inv_v_scale_val);
            if (v_clip > 80.0) v_clip = 80.0;
            else if (v_clip < -80.0) v_clip = -80.0;
            i_mem = g_i_scale * f22_active * sinh(v_clip);
        end

        // Joule Self-Heating Thermal ODE
        if (E_a > 0.0 && R_th > 0.0) begin
            p_diss = abs(v_int * i_mem);
            if (p_diss == 0.0 && abs(temp_curr - t_amb) <= 1e-4) begin
                d_temp_dt = 0.0;
            end else begin
                t_steady = t_amb + p_diss * R_th;
                d_temp_dt = (t_steady - temp_curr) * inv_tau_th;
            end
        end else begin
            d_temp_dt = 0.0;
        end

        // Apply Branch Current & Monitors
        I(TE, BE)  <+ i_mem;
        if (noise_en > 0.5 && read_noise_intensity > 0.0) begin
            `PWL_LOOKUP(rel_sigma_read, f22_active, x_rnoise, y_rnoise, 25)
            if (rel_sigma_read < 0.0) rel_sigma_read = 0.0;
            i_floor_noise = ((abs_v > 1e-6) ? abs_v : 0.1) * 1e-6;
            i_scale_noise = (abs(i_mem) > i_floor_noise) ? abs(i_mem) : i_floor_noise;
            pwr_read_noise = 2.0 * pow(read_noise_intensity * rel_sigma_read * i_scale_noise, 2.0) * 1.0e-9;
            I(TE, BE) <+ white_noise(pwr_read_noise, "read_noise");
        end
        if (mon_en > 0) begin
            V(f22)          <+ f22_active;
            V(pulseState)   <+ n_curr;
            V(conductance)  <+ (f22_active > 0.0) ? (g_i_scale * f22_active * (1.0 + gamma_eff * f22_active) * inv_v_scale_val * 1000.0) : 0.0;
            V(junctionTemp) <+ temp_curr;
        end

    end

endmodule
